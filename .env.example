# BhumiSense AI - Environment Variables Template
# Copy this file to .env and fill in the values

# Django
DJANGO_SECRET_KEY=your-super-secret-django-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Azure OpenAI
HACKATHON_ENDPOINT=https://hackathon-2026-2-resource.openai.azure.com/openai/v1/
HACKATHON_KEY=your-azure-openai-api-key-here
HACKATHON_MODEL=gpt-5.5
